# Maintainer: Joshua Friedman <65982269+jarmen423@users.noreply.github.com>
pkgname=cliamp-jarmen423
pkgver=3.3.0
pkgrel=1
pkgdesc='A retro terminal music player inspired by Winamp 2.x (jarmen423 fork)'
arch=('x86_64' 'aarch64')
url='https://github.com/jarmen423/cliamp'
license=('MIT')
depends=('alsa-lib' 'flac' 'libvorbis' 'libogg' 'mpg123' 'ffmpeg' 'yt-dlp')
optdepends=('pipewire-alsa: audio output on PipeWire systems'
            'pulseaudio-alsa: audio output on PulseAudio systems'
            'python-secretstorage: read Chromium-based browser cookies from GNOME Keyring via yt-dlp')
makedepends=('go')
options=('!debug')
provides=("cliamp=$pkgver")
conflicts=('cliamp')
replaces=('cliamp')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/jarmen423/cliamp/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('122e667bae0c1d04699ef9501cc164c3ab90a6de6f9b4406919928c684007da4')

build() {
    cd "cliamp-${pkgver}"
    export CGO_ENABLED=1
    go build -trimpath -ldflags="-s -w -X main.version=v${pkgver}" -o cliamp .
}

package() {
    cd "cliamp-${pkgver}"
    install -Dm755 cliamp "${pkgdir}/usr/bin/cliamp"
    install -Dm644 cliamp.desktop "${pkgdir}/usr/share/applications/cliamp.desktop"
    install -Dm644 Cliamp.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cliamp.png"
    install -Dm644 Cliamp.png "${pkgdir}/usr/share/pixmaps/cliamp.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
